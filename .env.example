# Optional remote alert delivery.
# Put real values in your Windows environment or local .env file.
# Never commit real credentials to Git.

SENTINELSHIELD_ALERT_COOLDOWN_SECONDS=120

SENTINELSHIELD_SMTP_HOST=smtp.example.com
SENTINELSHIELD_SMTP_PORT=587
SENTINELSHIELD_SMTP_TLS=true
SENTINELSHIELD_SMTP_USER=your_email@example.com
SENTINELSHIELD_SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD

SENTINELSHIELD_SMTP_FROM=your_email@example.com
SENTINELSHIELD_ALERT_EMAIL_TO=recipient@example.com

SENTINELSHIELD_TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
SENTINELSHIELD_TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

SENTINELSHIELD_TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
SENTINELSHIELD_TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
SENTINELSHIELD_TWILIO_FROM=YOUR_TWILIO_PHONE_NUMBER
SENTINELSHIELD_SMS_TO=YOUR_DESTINATION_PHONE_NUMBER
